import pandas as pd
import matplotlib.pyplot as plt
import shap

from sklearn.preprocessing import StandardScaler
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import r2_score, mean_squared_error

print("Libraries imported")

# =========================
# LOAD DATA
# =========================
df = pd.read_csv("ML.csv", encoding="latin1")

# Remove rows with missing predictors
df = df.dropna(subset=['SSP', 'PPC'])

print("Samples after NaN removal:", len(df))

# =========================
# FEATURES AND TARGET
# =========================
features = ['SSP', 'PPC']
X = df[features]

y = df['Coiling Ratio Index (CRI):\nCRI = D / (D + S)']

# =========================
# NORMALIZATION
# =========================
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# =========================
# TIME-ORDERED SPLIT
# =========================
split_index = int(0.7 * len(df))

X_train = X_scaled[:split_index]
X_test  = X_scaled[split_index:]

y_train = y[:split_index]
y_test  = y[split_index:]

X_train_df = pd.DataFrame(X_train, columns=features)
X_test_df  = pd.DataFrame(X_test, columns=features)

# =========================
# RANDOM FOREST REGRESSION
# =========================
rf = RandomForestRegressor(
    n_estimators=500,
    max_depth=5,
    random_state=42
)

rf.fit(X_train, y_train)

y_pred = rf.predict(X_test)

print("R²:", round(r2_score(y_test, y_pred), 2))
rmse = (mean_squared_error(y_test, y_pred)) ** 0.5
print("RMSE:", round(rmse, 3))

# =========================
# FEATURE IMPORTANCE
# =========================
plt.figure(figsize=(6,4))
plt.bar(features, rf.feature_importances_)
plt.ylabel("Relative Importance")
plt.title("Controls on Coiling Ratio Index (CRI)")
plt.tight_layout()
plt.show()

# =========================
# SHAP ANALYSIS (KEY FIGURE)
# =========================
explainer = shap.TreeExplainer(rf)
shap_values = explainer.shap_values(X_train_df)

shap.summary_plot(
    shap_values,
    X_train_df,
    feature_names=features,
    show=False
)
plt.show()

import pandas as pd
import matplotlib.pyplot as plt
import shap

from sklearn.preprocessing import StandardScaler
from sklearn.ensemble import RandomForestRegressor

# =========================
# LOAD DATA
# =========================
df = pd.read_csv("ML.csv", encoding="latin1")

# =========================
# SELECT COLUMNS
# =========================
features = ['SSP', 'PPC']
target = 'Coiling Ratio Index (CRI):\nCRI = D / (D + S)'

df = df.dropna(subset=features + [target])

X = df[features]
y = df[target]

# =========================
# SCALE FEATURES
# =========================
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)
X_df = pd.DataFrame(X_scaled, columns=features)

# =========================
# RANDOM FOREST MODEL
# =========================
rf = RandomForestRegressor(
    n_estimators=500,
    max_depth=6,
    random_state=42
)

rf.fit(X_df, y)

# =========================
# FEATURE IMPORTANCE (GLOBAL)
# =========================
importance = pd.Series(
    rf.feature_importances_,
    index=features
).sort_values(ascending=False)

print("\nRelative importance of parameters controlling CRI:\n")
print(importance)

importance.plot(kind='bar', figsize=(6,4))
plt.ylabel("Relative Importance")
plt.title("Controls on Coiling Ratio Index (CRI)")
plt.tight_layout()
plt.show()

# =========================
# SHAP ANALYSIS (MOST IMPORTANT)
# =========================
explainer = shap.TreeExplainer(rf)
shap_values = explainer.shap_values(X_df)

shap.summary_plot(
    shap_values,
    X_df,
    feature_names=features
)
