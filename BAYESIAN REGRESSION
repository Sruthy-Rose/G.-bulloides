import pandas as pd
import numpy as np

from sklearn.preprocessing import StandardScaler

import pymc as pm
import arviz as az

# =========================
# MAIN FUNCTION
# =========================
def main():

    # =========================
    # LOAD DATA
    # =========================
    df = pd.read_csv("ML.csv", encoding="latin1")

    features = ['SSP', 'PPC']
    target = 'Coiling Ratio Index (CRI):\nCRI = D / (D + S)'

    df = df.dropna(subset=features + [target])

    X = df[features]
    y = df[target].values

    # =========================
    # STANDARDIZE
    # =========================
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X)

    X_df = pd.DataFrame(X_scaled, columns=features)

    # =========================
    # BAYESIAN REGRESSION
    # =========================
    with pm.Model() as bayes_model:

        beta_ppc = pm.Normal("beta_ppc", mu=0, sigma=1)
        beta_ssp = pm.Normal("beta_ssp", mu=0, sigma=1)
        sigma = pm.HalfNormal("sigma", 1)

        mu = (
            beta_ppc * X_df["PPC"].values +
            beta_ssp * X_df["SSP"].values
        )

        pm.Normal("y_obs", mu=mu, sigma=sigma, observed=y)

        trace = pm.sample(
            draws=1000,
            tune=500,
            target_accept=0.9,
            chains=1,
            cores=1,
            progressbar=True
        )

    # =========================
    # OUTPUT
    # ========================
    # =========================
    # OUTPUT
    # =========================
    print(az.summary(trace, round_to=3))

# =========================
# ENTRY POINT
# =========================
if __name__ == "__main__":
    main()
