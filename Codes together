import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# ML / Stats
from sklearn.preprocessing import StandardScaler
from sklearn.model_selection import train_test_split
from sklearn.metrics import r2_score

# Random Forest
from sklearn.ensemble import RandomForestRegressor
import shap

# Gradient Boosting
from xgboost import XGBRegressor

# GAM
from pygam import LinearGAM, s

# SEM
from semopy import Model

# Multivariate
from sklearn.decomposition import PCA
from sklearn.linear_model import LinearRegression
# =========================
# LOAD DATA
# =========================
df = pd.read_csv("ML.csv", encoding="latin1")

features = ['SSP', 'PPC']
target = 'Coiling Ratio Index (CRI):\nCRI = D / (D + S)'

df = df.dropna(subset=features + [target])

X = df[features]
y = df[target]

# Standardize
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)
X_df = pd.DataFrame(X_scaled, columns=features)

1.


rf = RandomForestRegressor(
    n_estimators=500,
    max_depth=6,
    random_state=42
)

rf.fit(X_df, y)

# Feature importance
rf_importance = pd.Series(
    rf.feature_importances_,
    index=features
)

print("Random Forest importance:\n", rf_importance)

rf_importance.plot(kind='bar', title="RF Controls on CRI")
plt.show()

# SHAP
explainer = shap.TreeExplainer(rf)
shap_values = explainer.shap_values(X_df)

shap.summary_plot(shap_values, X_df)



2.

xgb = XGBRegressor(
    n_estimators=300,
    max_depth=4,
    learning_rate=0.05,
    subsample=0.8,
    random_state=42
)

xgb.fit(X_df, y)

xgb_importance = pd.Series(
    xgb.feature_importances_,
    index=features
)

print("XGBoost importance:\n", xgb_importance)

xgb_importance.plot(kind='bar', title="XGBoost Controls on CRI")
plt.show()

# SHAP for XGBoost
explainer_xgb = shap.Explainer(xgb)
shap_values_xgb = explainer_xgb(X_df)

shap.summary_plot(shap_values_xgb, X_df)

3.


gam = LinearGAM(
    s(0) + s(1)
).fit(X_scaled, y)

print(gam.summary())

# Plot smooth terms
fig, axs = plt.subplots(1, 2, figsize=(10,4))
titles = ['SSP effect', 'PPC effect']

for i, ax in enumerate(axs):
    XX = gam.generate_X_grid(term=i)
    ax.plot(XX[:, i], gam.partial_dependence(term=i, X=XX))
    ax.set_title(titles[i])

plt.tight_layout()
plt.show()



